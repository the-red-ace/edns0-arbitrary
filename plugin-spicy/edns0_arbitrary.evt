# Mapeamento Spicy<->Zeek do plugin edns0-arbitrary.
# Sem `replaces` — coexiste com o parser DNS core (que continua
# emitindo dns_request/dns_reply/dns_EDNS_* normais).

protocol analyzer spicy::EDNS0_Arbitrary over UDP:
    parse with EDNS0Arbitrary::Message,
    port 53/udp;

# Dispara 1 vez por opcao parseada dentro de qualquer pseudo-RR OPT.
# self.is_query e cascateado de Message -> ResourceRecord -> OPTRDATA
# -> EDNSOption via parametros de unit.
on EDNS0Arbitrary::EDNSOption -> event edns0_arbitrary_opt(
    $conn,
    self.is_query,
    self.option_code,
    self.option_length,
    self.option_data
);


# Dispara 1 vez por pseudo-RR OPT (rtype==41), expondo os campos do
# header do OPT que a heuristica H4 usa. rclass carrega o
# udp_payload_size (RFC 6891); ttl decompoe em extended_rcode (byte
# alto), version (byte seguinte) e flags (16 bits baixos). opt_count
# e o numero de opcoes enumeradas dentro deste OPT.
on EDNS0Arbitrary::ResourceRecord if (self.rtype == 41) -> event edns0_opt_record(
    $conn,
    self.is_query,
    self.rclass,
    (self.ttl >> 24) & 0xFF,
    (self.ttl >> 16) & 0xFF,
    self.ttl & 0xFFFF,
    |self.opt.options|
);
