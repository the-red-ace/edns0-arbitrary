# EDNStego Detection Rules for Suricata
# SBSeg 2026 - EDNS0 Evasion Project
# Contramedidas propostas para detectar abuso de EDNS0

# R1: EDNS0 OPT option com código experimental (65001-65534)
alert dns any any -> any any ( \
    msg:"EDNS0 Experimental OPT option detected (65001)"; \
    dns.opcode:0; \
    content:"|00 29|"; \
    content:"|FE 01|"; \
    threshold: type threshold, track by_src, count 5, seconds 60; \
    classtype:policy-violation; \
    sid:9000001; rev:1; \
)

# R1b: Variantes de códigos experimentais comuns
alert dns any any -> any any ( \
    msg:"EDNS0 Experimental OPT option detected (65002)"; \
    dns.opcode:0; \
    content:"|00 29|"; \
    content:"|FE 02|"; \
    threshold: type threshold, track by_src, count 5, seconds 60; \
    classtype:policy-violation; \
    sid:9000010; rev:1; \
)

# R2: EDNS0 Padding (code 12) com conteúdo não-zero
alert dns any any -> any any ( \
    msg:"EDNS0 Padding with non-zero content"; \
    dns.opcode:0; \
    content:"|00 0C|"; \
    pcre:"/[\x01-\xff]/R"; \
    classtype:policy-violation; \
    sid:9000002; rev:1; \
)

# R3: Cookie com entropia alta (detecção básica - tamanho anômalo)
alert dns any any -> any any ( \
    msg:"EDNS0 Cookie unusually large - possible covert channel"; \
    dns.opcode:0; \
    content:"|00 0A|"; \
    dsize:>200; \
    threshold: type threshold, track by_src, count 3, seconds 120; \
    classtype:policy-violation; \
    sid:9000003; rev:1; \
)

# R4: DNS query com EDNS0 buffer size incomum
# Valores legítimos típicos: 512, 1232, 1452, 4096
alert dns any any -> any any ( \
    msg:"EDNS0 unusual buffer size (possible T4 signaling)"; \
    dns.opcode:0; \
    content:"|00 29|"; \
    lua:edns0_bufsize_anomaly.lua; \
    threshold: type threshold, track by_src, count 3, seconds 120; \
    classtype:policy-violation; \
    sid:9000004; rev:1; \
)

# R5: CHAIN option (code 13) em tráfego não-DNSSEC
alert dns any any -> any any ( \
    msg:"EDNS0 CHAIN option detected - possible T5 evasion"; \
    dns.opcode:0; \
    content:"|00 0D|"; \
    threshold: type threshold, track by_src, count 10, seconds 60; \
    classtype:policy-violation; \
    sid:9000005; rev:1; \
)

# R6: Múltiplas opções EDNS0 na mesma query (possível T6 hybrid)
alert dns any any -> any any ( \
    msg:"EDNS0 multiple options in single query - possible hybrid evasion"; \
    dns.opcode:0; \
    content:"|00 29|"; \
    pcre:"/(?:\x00[\x0a\x0c\x0d].*){2,}/s"; \
    classtype:policy-violation; \
    sid:9000006; rev:1; \
)

# R7: Alta frequência de queries com EDNS0 OPT RR de um único host
alert dns any any -> any any ( \
    msg:"EDNS0 high frequency queries from single host"; \
    dns.opcode:0; \
    content:"|00 29|"; \
    threshold: type threshold, track by_src, count 100, seconds 60; \
    classtype:policy-violation; \
    sid:9000007; rev:1; \
)

# R8: DNS query com payload UDP > 1500 bytes (possível fragmentação)
alert dns any any -> any any ( \
    msg:"EDNS0 oversized DNS query - possible data exfiltration"; \
    dsize:>1500; \
    content:"|00 29|"; \
    classtype:policy-violation; \
    sid:9000008; rev:1; \
)
